@model ApiBiblio.Models.Emprunt

@{
    ViewData["Title"] = "Supprimer un emprunt";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container my-5">
    <div class="card shadow-sm">
        <div class="card-body">
            <h2 class="text-danger mb-3">
                <i class="bi bi-exclamation-circle-fill"></i> Suppression
            </h2>
            <p class="fs-5">Es-tu sûr de vouloir supprimer cet emprunt ?</p>

            <hr />

            <dl class="row">
                <dt class="col-sm-3">Date d’emprunt</dt>
                <dd class="col-sm-9">@Model.DateEmprunt.ToShortDateString()</dd>

                <dt class="col-sm-3">Statut</dt>
                <dd class="col-sm-9">@Model.Statut</dd>

                <dt class="col-sm-3">Date de retour</dt>
                <dd class="col-sm-9">@Model.DateRetour.ToShortDateString()</dd>

                <dt class="col-sm-3">Membre</dt>
                <dd class="col-sm-9">@Model.Membre.PrenomMembre @Model.Membre.NomMembre</dd>

                <dt class="col-sm-3">Livre</dt>
                <dd class="col-sm-9">@Model.Livre.Titre</dd>
            </dl>

            <form asp-action="Delete" class="mt-4 d-flex justify-content-between">
                <input type="hidden" asp-for="Id" />

                <a asp-action="Index" class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-left"></i> Retour à la liste
                </a>

                <button type="submit" class="btn btn-danger">
                    <i class="bi bi-trash"></i> Supprimer définitivement
                </button>
            </form>
        </div>
    </div>
</div>
