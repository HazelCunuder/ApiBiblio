@model ApiBiblio.Models.Emprunt

@{
    ViewData["Title"] = "Détails de l'emprunt";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;700&family=Merriweather:wght@700&display=swap" rel="stylesheet">

<style>
    .emprunt-header {
        color: #fff;
        font-family: 'Merriweather', serif;
        font-weight: 700;
        font-size: 2.1rem;
        text-shadow: 1px 2px 5px rgba(40,68,117,0.12);
        letter-spacing: 1px;
    }

    .emprunt-header-bar {
        background: #284475;
        border-radius: 1.5rem 1.5rem 0 0;
        padding: 1.25rem 1.8rem;
        box-shadow: 0 8px 32px rgba(40,68,117,0.10);
    }

    .emprunt-label {
        color: #427AA1;
        font-weight: 600;
        font-size: 1.08em;
    }

    .card-detail {
        background: #F5F6F8;
        border-radius: 1.5rem;
        box-shadow: 0 4px 16px rgba(40,68,117,0.12);
        border: none;
    }

    .btn-main {
        background: #72D6C9;
        color: #284475;
        border-radius: 1.5rem;
        font-weight: bold;
        border: none;
        box-shadow: 0 2px 8px rgba(40,68,117,0.09);
        transition: background 0.2s, color 0.2s;
    }

        .btn-main:hover {
            background: #427AA1;
            color: #FFD447;
        }

    .btn-outline-secondary {
        border-radius: 1.5rem;
        font-weight: 500;
    }
</style>

<div class="container my-5">
    <div class="card card-detail">
        <div class="emprunt-header-bar">
            <h2 class="emprunt-header m-0">
                <i class="bi bi-journal-check"></i> Détails de l'emprunt
            </h2>
        </div>
        <div class="card-body py-4 px-4">
            <dl class="row">
                <dt class="col-sm-4 emprunt-label">Date d'emprunt</dt>
                <dd class="col-sm-8">@Model.DateEmprunt.ToShortDateString()</dd>

                <dt class="col-sm-4 emprunt-label">Rendu ?</dt>
                <dd class="col-sm-8">
                    @if (Model.Statut)
                    {
                        <span class="badge rounded-pill" style="background:#72D6C9; color:#284475;">Oui</span>
                    }
                    else
                    {
                        <span class="badge rounded-pill" style="background:#EC5B5B;">Non</span>
                    }
                </dd>

                <dt class="col-sm-4 emprunt-label">Date de retour</dt>
                <dd class="col-sm-8">
                    @if (Model.Statut)
                    {
                        @Model.DateRetour.ToShortDateString()
                    }
                    else
                    {
                        <span class="text-warning">Pas encore rendu</span>
                    }
                </dd>

                <dt class="col-sm-4 emprunt-label">Membre</dt>
                <dd class="col-sm-8">
                    @Model.Membre?.PrenomMembre @Model.Membre?.NomMembre
                </dd>

                <dt class="col-sm-4 emprunt-label">Livre</dt>
                <dd class="col-sm-8">
                    @Model.Livre?.Titre
                </dd>
            </dl>
        </div>
        <div class="card-footer d-flex justify-content-between bg-white border-0 rounded-bottom-4 px-4 pb-3 pt-2">
            <a asp-action="Index" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left-circle"></i> Retour à la liste
            </a>
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-main">
                <i class="bi bi-pencil-square"></i> Modifier
            </a>
        </div>
    </div>
</div>
