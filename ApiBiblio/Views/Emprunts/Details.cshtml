@model ApiBiblio.Models.Emprunt

@{
    ViewData["Title"] = "Détails de l'emprunt";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container my-5">
    <div class="card shadow-sm">
        <div class="card-header bg-primary text-white">
            <h2><i class="bi bi-journal-check"></i> Détails de l'emprunt</h2>
        </div>
        <div class="card-body">
            <dl class="row">
                <dt class="col-sm-3">Date d'emprunt</dt>
                <dd class="col-sm-9">@Model.DateEmprunt.ToShortDateString()</dd>

                <dt class="col-sm-3">Statut</dt>
                <dd class="col-sm-9">@Model.Statut</dd>

                <dt class="col-sm-3">Date de retour</dt>
                <dd class="col-sm-9">@Model.DateRetour.ToShortDateString()</dd>

                <dt class="col-sm-3">Membre</dt>
                <dd class="col-sm-9">@Model.Membre.PrenomMembre @Model.Membre.NomMembre</dd>

                <dt class="col-sm-3">Livre</dt>
                <dd class="col-sm-9">@Model.Livre.Titre</dd>
            </dl>
        </div>
        <div class="card-footer d-flex justify-content-between">
            <a asp-action="Index" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left-circle"></i> Retour à la liste
            </a>
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">
                <i class="bi bi-pencil-square"></i> Modifier
            </a>
        </div>
    </div>
</div>
