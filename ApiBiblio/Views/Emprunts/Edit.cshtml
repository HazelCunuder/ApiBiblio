@model ApiBiblio.Models.Emprunt

@{
    ViewData["Title"] = "Modifier un emprunt";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container my-5">
    <div class="card shadow">
        <div class="card-header bg-primary text-white">
            <h2><i class="bi bi-pencil-square"></i> Modifier l'emprunt</h2>
        </div>
        <div class="card-body">
            <form asp-action="Edit">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
                <input type="hidden" asp-for="Id" />

                <div class="mb-3">
                    <label asp-for="DateEmprunt" class="form-label"></label>
                    <input asp-for="DateEmprunt" class="form-control" />
                    <span asp-validation-for="DateEmprunt" class="text-danger"></span>
                </div>

                <div class="form-check mb-3">
                    <input class="form-check-input" asp-for="Statut" />
                    <label class="form-check-label" asp-for="Statut">
                        @Html.DisplayNameFor(model => model.Statut)
                    </label>
                </div>

                <div class="mb-3">
                    <label asp-for="DateRetour" class="form-label"></label>
                    <input asp-for="DateRetour" class="form-control" />
                    <span asp-validation-for="DateRetour" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="IdMembre" class="form-label"></label>
                    <select asp-for="IdMembre" class="form-select" asp-items="ViewBag.IdMembre"></select>
                    <span asp-validation-for="IdMembre" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="IdLivre" class="form-label">
                        @Html.DisplayNameFor(model => model.Livre.Titre)
                    </label>
                    <select asp-for="IdLivre" class="form-select" asp-items="ViewBag.IdLivre"></select>
                    <span asp-validation-for="IdLivre" class="text-danger"></span>
                </div>

                <div class="d-flex justify-content-between mt-4">
                    <a asp-action="Index" class="btn btn-outline-secondary">
                        <i class="bi bi-arrow-left-circle"></i> Retour à la liste
                    </a>
                    <button type="submit" class="btn btn-success">
                        <i class="bi bi-save"></i> Sauvegarder
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
