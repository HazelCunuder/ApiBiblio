@model ApiBiblio.Models.Emprunt

@{
    ViewData["Title"] = "Modifier un emprunt";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;700&family=Merriweather:wght@700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

<style>
    .form-header-emprunt {
        background: #284475;
        color: #FFF;
        border-radius: 1.5rem 1.5rem 0 0;
        padding: 1.2rem 2rem;
        font-family: 'Merriweather', serif;
        font-size: 1.4rem;
        font-weight: bold;
        box-shadow: 0 4px 18px rgba(40,68,117,0.10);
    }

    .card-biblio-form {
        border-radius: 1.5rem;
        box-shadow: 0 8px 32px rgba(40,68,117,0.11);
        border: none;
    }

    .btn-main {
        background: #72D6C9;
        color: #284475;
        border-radius: 1.5rem;
        font-weight: bold;
        border: none;
        box-shadow: 0 2px 8px rgba(40,68,117,0.09);
        transition: background 0.2s, color 0.2s;
    }

        .btn-main:hover {
            background: #427AA1;
            color: #FFD447;
        }
</style>

<div class="container my-5">
    <div class="card card-biblio-form">
        <div class="form-header-emprunt">
            <i class="bi bi-pencil-square"></i> Modifier l'emprunt
        </div>
        <div class="card-body p-4">
            <form asp-action="Edit">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
                <input type="hidden" asp-for="Id" />

                <div class="mb-3">
                    <label asp-for="DateEmprunt" class="form-label fw-bold"></label>
                    <input asp-for="DateEmprunt" class="form-control" type="date" />
                    <span asp-validation-for="DateEmprunt" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="DateRetour" class="form-label fw-bold"></label>
                    <input asp-for="DateRetour" class="form-control" type="date" />
                    <span asp-validation-for="DateRetour" class="text-danger"></span>
                </div>

                <div class="mb-3 form-check">
                    <input asp-for="Statut" class="form-check-input" type="checkbox" />
                    <label class="form-check-label" asp-for="Statut">Livre rendu ?</label>
                    <span asp-validation-for="Statut" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="IdMembre" class="form-label fw-bold"></label>
                    <select asp-for="IdMembre" class="form-select" asp-items="ViewBag.IdMembre"></select>
                    <span asp-validation-for="IdMembre" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="IdLivre" class="form-label fw-bold">@Html.DisplayNameFor(model => model.Livre.Titre)</label>
                    <select asp-for="IdLivre" class="form-select" asp-items="ViewBag.IdLivre"></select>
                    <span asp-validation-for="IdLivre" class="text-danger"></span>
                </div>

                <div class="d-flex justify-content-between mt-4">
                    <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">
                        <i class="bi bi-arrow-left-circle"></i> Retour à la liste
                    </a>
                    <button type="submit" class="btn btn-main rounded-pill px-4">
                        <i class="bi bi-save"></i> Sauvegarder
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
