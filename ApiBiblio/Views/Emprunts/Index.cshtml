@model IEnumerable<ApiBiblio.Models.Emprunt>

@{
    ViewData["Title"] = "Historique d'emprunts";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;700&family=Merriweather:wght@700&display=swap" rel="stylesheet">

<style>
    body {
        background: #FAFAF7;
        color: #273043;
        font-family: 'Inter', sans-serif;
    }

    .emprunt-title {
        color: #fff;
        background: linear-gradient(90deg, #427AA1 80%, #72D6C9 120%);
        border-radius: 1.2rem 1.2rem 0 0;
        padding: 1.3rem 2.3rem 1.05rem 2.3rem;
        font-family: 'Merriweather', serif;
        font-size: 2rem;
        font-weight: bold;
        margin-bottom: 0.6em;
        letter-spacing: -1px;
        display: flex;
        align-items: center;
        gap: 0.7em;
    }

    .btn-main {
        background: #72D6C9;
        color: #284475;
        border-radius: 1.5rem;
        font-weight: bold;
        border: none;
        box-shadow: 0 2px 8px rgba(40,68,117,0.09);
        transition: background 0.15s, color 0.15s;
        padding: 0.62em 1.6em;
    }

        .btn-main:hover {
            background: #427AA1;
            color: #FFD447;
        }

    .emprunt-card {
        border-radius: 1.3rem;
        background: #F5F6F8;
        box-shadow: 0 6px 22px rgba(40,68,117,0.13);
        border: none;
    }

    .table-custom th {
        background: #427AA1;
        color: #FAFAF7;
        border: none;
        font-size: 1.05em;
    }

    .table-custom td {
        background: #F5F6F8;
        color: #273043;
        border-top: 2px solid #FAFAF7;
        font-size: 1em;
        vertical-align: middle;
    }

    .btn-warning {
        background: #FFD447;
        color: #284475;
        border-radius: 1.2rem;
        border: none;
    }

        .btn-warning:hover {
            background: #284475;
            color: #FFD447;
        }

    .btn-info {
        background: #72D6C9;
        color: #284475;
        border-radius: 1.2rem;
        border: none;
    }

        .btn-info:hover {
            background: #427AA1;
            color: #FFD447;
        }

    .btn-danger {
        background: #EC5B5B;
        color: #fff;
        border-radius: 1.2rem;
        border: none;
    }

        .btn-danger:hover {
            background: #ff6b6b;
            color: #fff;
        }
</style>

<div class="container my-5">
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap">
        <div class="emprunt-title mb-2">
            <i class="bi bi-clock-history"></i> @ViewData["Title"]
        </div>
        <a class="btn btn-main mb-2" asp-action="Create">
            <i class="bi bi-plus-circle"></i> Déclarer un nouvel emprunt
        </a>
    </div>

    <div class="emprunt-card p-0">
        <div class="table-responsive">
            <table class="table table-custom align-middle mb-0">
                <thead>
                    <tr>
                        <th>@Html.DisplayNameFor(model => model.First().DateEmprunt)</th>
                        <th>@Html.DisplayNameFor(model => model.First().Statut)</th>
                        <th>@Html.DisplayNameFor(model => model.First().DateRetour)</th>
                        <th>@Html.DisplayNameFor(model => model.First().Membre)</th>
                        <th>@Html.DisplayNameFor(model => model.First().Livre)</th>
                        <th class="text-center">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@Html.DisplayFor(modelItem => item.DateEmprunt)</td>
                            <td>
                                @if (item.Statut)  // Statut = true => rendu / terminé
                                {
                                    <span class="badge" style="background:#72D6C9; color:#284475;">Terminé</span>
                                }
                                else
                                {
                                    <span class="badge" style="background:#FFD447; color:#284475;">En cours</span>
                                }
                            </td>
                            <td>@Html.DisplayFor(modelItem => item.DateRetour)</td>
                            <td>
                                @item.Membre?.PrenomMembre @item.Membre?.NomMembre
                            </td>
                            <td>
                                @item.Livre?.Titre
                            </td>
                            <td class="text-center">
                                <a class="btn btn-warning btn-sm me-1" asp-action="Edit" asp-route-id="@item.Id" title="Modifier">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <a class="btn btn-info btn-sm me-1 text-white" asp-action="Details" asp-route-id="@item.Id" title="Détails">
                                    <i class="bi bi-eye"></i>
                                </a>
                                <a class="btn btn-danger btn-sm" asp-action="Delete" asp-route-id="@item.Id" title="Supprimer">
                                    <i class="bi bi-trash"></i>
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
