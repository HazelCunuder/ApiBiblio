@model ApiBiblio.Models.Employe

@{
    ViewData["Title"] = "Détails de l'employé";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container my-5">
    <h2 class="mb-4"><i class="bi bi-person-lines-fill text-info"></i> @ViewData["Title"]</h2>

    <div class="card shadow-sm border-0">
        <div class="card-body">
            <dl class="row">
                <dt class="col-sm-3">Nom</dt>
                <dd class="col-sm-9">@Model.NomEmploye</dd>

                <dt class="col-sm-3">Prénom</dt>
                <dd class="col-sm-9">@Model.PrenomEmploye</dd>

                <dt class="col-sm-3">Login</dt>
                <dd class="col-sm-9">@Model.LoginEmploye</dd>

                <dt class="col-sm-3">Mot de passe</dt>
                <dd class="col-sm-9">@Html.Raw(new string('•', 8))</dd>

                <dt class="col-sm-3">Rôle</dt>
                <dd class="col-sm-9">@Model.Role?.NomRole</dd>
            </dl>

            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning me-2">
                <i class="bi bi-pencil-square"></i> Modifier
            </a>
            <a asp-action="Index" class="btn btn-secondary">
                <i class="bi bi-list-ul"></i> Retour à la liste
            </a>
        </div>
    </div>
</div>
