@model ApiBiblio.Models.Employe

@{
    ViewData["Title"] = "Supprimer l'employé";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container my-5">
    <h2 class="mb-4 text-danger"><i class="bi bi-trash-fill"></i> @ViewData["Title"]</h2>

    <div class="card shadow-sm border-danger">
        <div class="card-body">
            <h5 class="text-danger">Êtes-vous sûr de vouloir supprimer cet employé ?</h5>

            <dl class="row mt-4">
                <dt class="col-sm-3">Nom</dt>
                <dd class="col-sm-9">@Model.NomEmploye</dd>

                <dt class="col-sm-3">Prénom</dt>
                <dd class="col-sm-9">@Model.PrenomEmploye</dd>

                <dt class="col-sm-3">Login</dt>
                <dd class="col-sm-9">@Model.LoginEmploye</dd>

                <dt class="col-sm-3">Rôle</dt>
                <dd class="col-sm-9">@Model.Role?.NomRole</dd>
            </dl>

            <form asp-action="Delete" method="post" class="mt-3">
                <input type="hidden" asp-for="Id" />
                <button type="submit" class="btn btn-danger">
                    <i class="bi bi-trash3-fill"></i> Supprimer
                </button>
                <a asp-action="Index" class="btn btn-outline-secondary ms-2">
                    <i class="bi bi-x-circle"></i> Annuler
                </a>
            </form>
        </div>
    </div>
</div>
