@model IEnumerable<ApiBiblio.Models.Employe>

@{
    ViewData["Title"] = "Liste des employés";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container my-5">
    <h2 class="mb-4">
        <i class="bi bi-people-fill text-primary"></i> @ViewData["Title"]
    </h2>

    <div class="mb-3 text-end">
        <a asp-action="Create" class="btn btn-success">
            <i class="bi bi-person-plus-fill"></i> Nouvel employé
        </a>
    </div>

    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle">
            <thead class="table-dark">
                <tr>
                    <th>@Html.DisplayNameFor(model => model.First().NomEmploye)</th>
                    <th>@Html.DisplayNameFor(model => model.First().PrenomEmploye)</th>
                    <th>@Html.DisplayNameFor(model => model.First().LoginEmploye)</th>
                    <th>@Html.DisplayNameFor(model => model.First().MdpEmploye)</th>
                    <th>@Html.DisplayNameFor(model => model.First().Role.NomRole)</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@Html.DisplayFor(modelItem => item.NomEmploye)</td>
                        <td>@Html.DisplayFor(modelItem => item.PrenomEmploye)</td>
                        <td>@Html.DisplayFor(modelItem => item.LoginEmploye)</td>
                        <td>
                            @if (!string.IsNullOrEmpty(item.MdpEmploye))
                            {
                                @Html.Raw("&#8226;&#8226;&#8226;&#8226;&#8226;&#8226;&#8226;&#8226;&#8226;&#8226;")
                            }
                        </td>
                        <td>@Html.DisplayFor(modelItem => item.Role.NomRole)</td>
                        <td class="text-end">
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary me-1">
                                <i class="bi bi-pencil-square"></i>
                            </a>
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info me-1">
                                <i class="bi bi-eye-fill"></i>
                            </a>
                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">
                                <i class="bi bi-trash-fill"></i>
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
