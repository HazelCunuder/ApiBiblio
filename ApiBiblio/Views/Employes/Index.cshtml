@model IEnumerable<ApiBiblio.Models.Employe>

@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.NomEmploye)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.PrenomEmploye)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.LoginEmploye)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.MdpEmploye)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Role)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.NomEmploye)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.PrenomEmploye)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.LoginEmploye)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.MdpEmploye)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Role.NomRole)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.Id">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.Id">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.Id">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
