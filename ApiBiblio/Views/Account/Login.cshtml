@model ApiBiblio.Models.Employe

@{
    ViewData["Title"] = "Connexion";
}

<h2>Connexion</h2>

@if (ViewBag.Error != null)
{
    <div class="alert alert-danger">@ViewBag.Error</div>
}

@if (ViewBag.Message != null)
{
    <div class="alert alert-success">@ViewBag.Message</div>
}

<form asp-action="Login" method="post">
    <div class="form-group">
        <label for="loginEmploye">Login:</label>
        <input type="text" class="form-control" id="loginEmploye" name="loginEmploye" required />
    </div>
    <div class="form-group">
        <label for="mdpEmploye">Mot de passe:</label>
        <input type="password" class="form-control" id="mdpEmploye" name="mdpEmploye" required />
    </div>
    <button type="submit" class="btn btn-primary">Se connecter</button>
</form>

<div class="mt-3">
    <p>Vous n'avez pas de compte ? <a href="@Url.Action("Create", "Account")">Créer un compte</a></p>
</div>
