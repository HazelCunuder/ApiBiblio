@model IEnumerable<ApiBiblio.Models.Categorie>

@{
    ViewData["Title"] = "Catégories";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;700&family=Merriweather:wght@700&display=swap" rel="stylesheet">

<style>
    body {
        background: #FAFAF7;
        color: #273043;
        font-family: 'Inter', sans-serif;
    }

    .categorie-header {
        color: #fff;
        background: linear-gradient(90deg, #427AA1 80%, #72D6C9 120%);
        border-radius: 1rem 1rem 0 0;
        padding: 1.2rem 2rem 0.9rem 2rem;
        font-family: 'Merriweather', serif;
        font-size: 2rem;
        font-weight: bold;
        margin-bottom: 0;
        letter-spacing: -1px;
        display: flex;
        align-items: center;
        gap: 0.7em;
    }

    .btn-main {
        background: #72D6C9;
        color: #284475;
        border-radius: 1.5rem;
        font-weight: bold;
        border: none;
        box-shadow: 0 2px 8px rgba(40,68,117,0.10);
        transition: background 0.18s, color 0.18s;
        padding: 0.62em 1.65em;
    }

        .btn-main:hover {
            background: #427AA1;
            color: #FFD447;
        }

    .table-custom {
        background: #fff;
        border-radius: 0 0 1rem 1rem;
        box-shadow: 0 6px 22px rgba(40,68,117,0.09);
        overflow: hidden;
    }

        .table-custom th {
            background: #427AA1;
            color: #fff;
            border: none;
            font-size: 1.07em;
        }

        .table-custom td {
            background: #F5F6F8;
            color: #273043;
            border-top: 2px solid #FAFAF7;
            font-size: 1em;
        }

    .btn-warning {
        background: #FFD447;
        color: #284475;
        border-radius: 1.2rem;
        border: none;
    }

        .btn-warning:hover {
            background: #284475;
            color: #FFD447;
        }

    .btn-info {
        background: #72D6C9;
        color: #284475;
        border-radius: 1.2rem;
        border: none;
    }

        .btn-info:hover {
            background: #427AA1;
            color: #FFD447;
        }

    .btn-danger {
        background: #EC5B5B;
        color: #fff;
        border-radius: 1.2rem;
        border: none;
    }

        .btn-danger:hover {
            background: #ff6b6b;
            color: #fff;
        }
</style>

<div class="container my-5">
    <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap">
        <div class="categorie-header mb-2">
            <i class="bi bi-tags-fill"></i> @ViewData["Title"]
        </div>
        <a asp-action="Create" class="btn btn-main">
            <i class="bi bi-plus-circle"></i> Ajouter une catégorie
        </a>
    </div>

    <div class="table-responsive">
        <table class="table table-custom align-middle">
            <thead>
                <tr>
                    <th>@Html.DisplayNameFor(model => model.First().NomCategorie)</th>
                    <th class="text-center">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@Html.DisplayFor(modelItem => item.NomCategorie)</td>
                        <td class="text-center">
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-warning btn-sm me-1">
                                <i class="bi bi-pencil-square"></i> Modifier
                            </a>
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-info btn-sm me-1 text-white">
                                <i class="bi bi-eye-fill"></i> Détails
                            </a>
                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger btn-sm">
                                <i class="bi bi-trash3-fill"></i> Supprimer
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
