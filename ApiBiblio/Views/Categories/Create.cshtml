@model ApiBiblio.Models.Categorie

@{
    ViewData["Title"] = "Créer une catégorie";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;700&family=Merriweather:wght@700&display=swap" rel="stylesheet">

<style>
    body {
        background: #FAFAF7;
        color: #273043;
        font-family: 'Inter', sans-serif;
    }

    .categorie-create-card {
        background: #fff;
        border-radius: 1.5rem;
        box-shadow: 0 6px 22px rgba(40,68,117,0.10);
        max-width: 480px;
        margin: 3rem auto;
        padding: 2.2rem 2.5rem 1.2rem 2.5rem;
    }

    .categorie-create-title {
        color: #427AA1;
        font-family: 'Merriweather', serif;
        font-size: 2rem;
        font-weight: bold;
        margin-bottom: 1.6rem;
        text-align: center;
    }

    .btn-main {
        background: #72D6C9;
        color: #284475;
        border-radius: 1.5rem;
        font-weight: bold;
        border: none;
        padding: 0.65em 2.2em;
        box-shadow: 0 2px 8px rgba(40,68,117,0.09);
        transition: background 0.2s, color 0.2s;
    }

        .btn-main:hover {
            background: #427AA1;
            color: #FFD447;
        }

    .btn-retour {
        border-radius: 1.2rem;
        color: #427AA1;
        font-weight: 600;
        background: #F5F6F8;
        padding: 0.6em 1.8em;
        border: none;
        transition: background 0.18s, color 0.18s;
    }

        .btn-retour:hover {
            background: #427AA1;
            color: #FFD447;
        }
</style>

<div class="categorie-create-card">
    <div class="categorie-create-title">
        <i class="bi bi-plus-circle-fill text-success"></i> @ViewData["Title"]
    </div>

    <form asp-action="Create">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

        <div class="mb-3">
            <label asp-for="NomCategorie" class="form-label"></label>
            <input asp-for="NomCategorie" class="form-control" placeholder="Ex: Science-Fiction" />
            <span asp-validation-for="NomCategorie" class="text-danger"></span>
        </div>

        <div class="d-flex justify-content-between mt-4">
            <a asp-action="Index" class="btn btn-retour">
                <i class="bi bi-arrow-left-circle"></i> Retour à la liste
            </a>
            <button type="submit" class="btn btn-main">
                <i class="bi bi-check-circle-fill"></i> Créer
            </button>
        </div>
    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
