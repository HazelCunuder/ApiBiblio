@model ApiBiblio.Models.Categorie

@{
    ViewData["Title"] = "Suppression de la catégorie";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container my-5">
    <h2 class="text-danger mb-4">
        <i class="bi bi-trash-fill"></i> @ViewData["Title"]
    </h2>

    <div class="alert alert-warning" role="alert">
        <i class="bi bi-exclamation-triangle-fill"></i>
        Êtes-vous sûr de vouloir supprimer cette catégorie ?
        Cette action est irréversible.
    </div>

    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body">
            <dl class="row mb-0">
                <dt class="col-sm-3 fw-bold">
                    @Html.DisplayNameFor(model => model.NomCategorie)
                </dt>
                <dd class="col-sm-9">
                    @Html.DisplayFor(model => model.NomCategorie)
                </dd>
            </dl>
        </div>
    </div>

    <form asp-action="Delete" method="post">
        <input type="hidden" asp-for="Id" />
        <div class="d-flex justify-content-between">
            <a asp-action="Index" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left-circle"></i> Retour à la liste
            </a>
            <button type="submit" class="btn btn-danger">
                <i class="bi bi-trash"></i> Supprimer
            </button>
        </div>
    </form>
</div>
