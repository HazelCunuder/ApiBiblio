@model ApiBiblio.Models.Auteur

@{
    ViewData["Title"] = "Supprimer l’auteur";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container my-5">
    <div class="card shadow-lg border-danger rounded-4">
        <div class="card-header bg-danger text-white">
            <h3 class="mb-0">
                <i class="bi bi-exclamation-triangle-fill"></i> Confirmation de suppression
            </h3>
        </div>
        <div class="card-body">
            <p class="lead">Êtes-vous sûr de vouloir supprimer cet auteur ? Cette action est irréversible.</p>
            <hr />
            <dl class="row">
                <dt class="col-sm-3 fw-bold">@Html.DisplayNameFor(model => model.NomAuteur)</dt>
                <dd class="col-sm-9">@Html.DisplayFor(model => model.NomAuteur)</dd>

                <dt class="col-sm-3 fw-bold">@Html.DisplayNameFor(model => model.PrenomAuteur)</dt>
                <dd class="col-sm-9">@Html.DisplayFor(model => model.PrenomAuteur)</dd>
            </dl>
        </div>
        <div class="card-footer d-flex justify-content-between">
            <form asp-action="Delete" class="mb-0">
                <input type="hidden" asp-for="Id" />
                <button type="submit" class="btn btn-danger">
                    <i class="bi bi-trash-fill"></i> Supprimer
                </button>
            </form>
            <a asp-action="Index" class="btn btn-secondary">
                <i class="bi bi-arrow-left-circle"></i> Retour à la liste
            </a>
        </div>
    </div>
</div>
