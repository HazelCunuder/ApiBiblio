@model ApiBiblio.Models.Auteur

@{
    ViewData["Title"] = "Ajouter un auteur";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;700&family=Merriweather:wght@700&display=swap" rel="stylesheet">

<style>
    .biblio-card {
        background: #F5F6F8;
        border-radius: 1.8rem;
        box-shadow: 0 6px 26px rgba(40,68,117,0.14);
        border: none;
        padding: 2.5rem 2rem 2rem 2rem;
        max-width: 540px;
        margin: 2rem auto;
    }

    .biblio-header {
        color: #284475;
        font-family: 'Merriweather', serif;
        font-weight: 700;
        margin-bottom: 1.7rem;
        font-size: 1.7rem;
        letter-spacing: 0.5px;
    }

    .form-label {
        color: #427AA1;
        font-weight: 600;
        letter-spacing: 0.4px;
    }

    .form-control {
        border-radius: 1.2rem;
        border: 2px solid #e2e5eb;
        box-shadow: 0 2px 8px rgba(40,68,117,0.07);
        font-family: 'Inter', sans-serif;
        font-size: 1.09em;
        transition: border 0.2s;
    }

        .form-control:focus {
            border-color: #72D6C9;
            outline: none;
            box-shadow: 0 2px 16px rgba(114,214,201,0.18);
        }

    .btn-main {
        background: #72D6C9;
        color: #284475;
        border-radius: 1.5rem;
        font-weight: bold;
        border: none;
        font-size: 1.08em;
        padding: 0.55em 1.7em;
        box-shadow: 0 2px 8px rgba(40,68,117,0.11);
        transition: background 0.18s, color 0.18s;
    }

        .btn-main:hover {
            background: #427AA1;
            color: #FFD447;
        }

    .btn-retour {
        background: #FFD447;
        color: #284475;
        border-radius: 1.2rem;
        font-weight: 600;
        border: none;
        font-size: 1.02em;
        padding: 0.45em 1.5em;
        margin-left: 1em;
        transition: background 0.18s, color 0.18s;
    }

        .btn-retour:hover {
            background: #284475;
            color: #FFD447;
        }

    .alert-danger {
        border-radius: 1.2em;
    }
</style>

<div class="biblio-card">
    <div class="biblio-header">
        <i class="bi bi-person-plus-fill"></i> Ajouter un nouvel auteur
    </div>
    <form asp-action="Create">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

        <div class="mb-3">
            <label asp-for="NomAuteur" class="form-label"></label>
            <input asp-for="NomAuteur" class="form-control" autocomplete="off" />
            <span asp-validation-for="NomAuteur" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="PrenomAuteur" class="form-label"></label>
            <input asp-for="PrenomAuteur" class="form-control" autocomplete="off" />
            <span asp-validation-for="PrenomAuteur" class="text-danger"></span>
        </div>

        <div class="d-flex justify-content-between align-items-center mt-4">
            <button type="submit" class="btn btn-main">
                <i class="bi bi-check-circle-fill"></i> Enregistrer
            </button>
            <a asp-action="Index" class="btn btn-retour">
                <i class="bi bi-arrow-left-circle"></i> Retour à la liste
            </a>
        </div>
    </form>
</div>
