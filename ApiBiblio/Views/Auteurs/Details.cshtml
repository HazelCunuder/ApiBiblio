@model ApiBiblio.Models.Auteur

@{
    ViewData["Title"] = "Détails de l’auteur";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;700&family=Merriweather:wght@700&display=swap" rel="stylesheet">

<style>
    .biblio-card {
        background: #F5F6F8;
        border-radius: 1.8rem;
        box-shadow: 0 6px 26px rgba(40,68,117,0.14);
        border: none;
        max-width: 540px;
        margin: 2rem auto;
        font-family: 'Inter', sans-serif;
    }

    .biblio-header {
        background: #427AA1;
        color: #F5F6F8;
        border-radius: 1.8rem 1.8rem 0 0;
        font-family: 'Merriweather', serif;
        font-weight: 700;
        padding: 1.4rem 2rem 1.1rem 2rem;
        font-size: 1.6rem;
        letter-spacing: 0.5px;
    }

    .biblio-details dt {
        color: #427AA1;
        font-weight: 700;
        font-size: 1.09em;
        font-family: 'Inter', sans-serif;
    }

    .biblio-details dd {
        color: #284475;
        font-size: 1.09em;
        margin-bottom: 0.7em;
        font-family: 'Inter', sans-serif;
    }

    .card-footer {
        background: transparent;
        border: none;
        border-radius: 0 0 1.8rem 1.8rem;
        padding-bottom: 1.3em;
        padding-top: 1.1em;
    }

    .btn-main {
        background: #72D6C9;
        color: #284475;
        border-radius: 1.5rem;
        font-weight: bold;
        border: none;
        font-size: 1.06em;
        padding: 0.5em 1.6em;
        box-shadow: 0 2px 8px rgba(40,68,117,0.11);
        transition: background 0.18s, color 0.18s;
    }

        .btn-main:hover {
            background: #427AA1;
            color: #FFD447;
        }

    .btn-retour {
        background: #FFD447;
        color: #284475;
        border-radius: 1.2rem;
        font-weight: 600;
        border: none;
        font-size: 1.02em;
        padding: 0.45em 1.5em;
        margin-left: 1em;
        transition: background 0.18s, color 0.18s;
    }

        .btn-retour:hover {
            background: #284475;
            color: #FFD447;
        }
</style>

<div class="biblio-card">
    <div class="biblio-header">
        <i class="bi bi-person-lines-fill"></i> Détails de l’auteur
    </div>
    <div class="card-body">
        <dl class="row biblio-details">
            <dt class="col-sm-4">@Html.DisplayNameFor(model => model.NomAuteur)</dt>
            <dd class="col-sm-8">@Html.DisplayFor(model => model.NomAuteur)</dd>
            <dt class="col-sm-4">@Html.DisplayNameFor(model => model.PrenomAuteur)</dt>
            <dd class="col-sm-8">@Html.DisplayFor(model => model.PrenomAuteur)</dd>
        </dl>
    </div>
    <div class="card-footer d-flex justify-content-between">
        <a asp-action="Edit" asp-route-id="@Model?.Id" class="btn btn-main">
            <i class="bi bi-pencil"></i> Modifier
        </a>
        <a asp-action="Index" class="btn btn-retour">
            <i class="bi bi-arrow-left-circle"></i> Retour à la liste
        </a>
    </div>
</div>
