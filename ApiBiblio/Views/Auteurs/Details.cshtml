@model ApiBiblio.Models.Auteur

@{
    ViewData["Title"] = "Détails de l’auteur";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container my-5">
    <div class="card shadow rounded-4">
        <div class="card-header bg-primary text-white">
            <h3 class="mb-0">
                <i class="bi bi-person-lines-fill"></i> Détails de l’auteur
            </h3>
        </div>
        <div class="card-body">
            <dl class="row">
                <dt class="col-sm-3 fw-bold">
                    @Html.DisplayNameFor(model => model.NomAuteur)
                </dt>
                <dd class="col-sm-9">
                    @Html.DisplayFor(model => model.NomAuteur)
                </dd>

                <dt class="col-sm-3 fw-bold">
                    @Html.DisplayNameFor(model => model.PrenomAuteur)
                </dt>
                <dd class="col-sm-9">
                    @Html.DisplayFor(model => model.PrenomAuteur)
                </dd>
            </dl>
        </div>
        <div class="card-footer d-flex justify-content-between">
            <a asp-action="Edit" asp-route-id="@Model?.Id" class="btn btn-outline-primary">
                <i class="bi bi-pencil"></i> Modifier
            </a>
            <a asp-action="Index" class="btn btn-secondary">
                <i class="bi bi-arrow-left-circle"></i> Retour à la liste
            </a>
        </div>
    </div>
</div>
