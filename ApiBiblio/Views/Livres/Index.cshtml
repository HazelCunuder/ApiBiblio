@model IEnumerable<ApiBiblio.Models.Livre>
@{
    ViewBag.Title = "Livres";
    // Détection du rôle employé ou admin
    var isEmployeOrAdmin = User.IsInRole("Admin") || User.IsInRole("Employe");
}

<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;700&family=Merriweather:wght@700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

<style>
    body {
        background: #FAFAF7;
        color: #273043;
        font-family: 'Inter', sans-serif;
    }

    .bibli-card {
        background: #F5F6F8;
        border-radius: 1.5rem;
        box-shadow: 0 4px 16px rgba(40,68,117,0.10);
        border: none;
        transition: transform 0.1s, box-shadow 0.1s;
    }

        .bibli-card:hover {
            transform: translateY(-6px) scale(1.02);
            box-shadow: 0 10px 32px rgba(40,68,117,0.18);
        }

    .card-title {
        color: #284475;
        font-family: 'Merriweather', serif;
        font-size: 1.3rem;
    }

    .badge-categorie {
        background: #FFD447;
        color: #284475;
        font-weight: 600;
        border-radius: 1rem;
        font-size: 0.9rem;
    }

    .badge-dispo {
        border-radius: 1rem;
        font-size: 0.95rem;
        font-weight: 600;
        padding: 0.25em 0.9em;
    }

        .badge-dispo.dispo {
            background: #72D6C9;
            color: #284475;
        }

        .badge-dispo.indispo {
            background: #EC5B5B;
            color: #fff;
        }
