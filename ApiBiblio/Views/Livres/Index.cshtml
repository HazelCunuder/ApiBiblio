@model IEnumerable<ApiBiblio.DTOs.LivreDTO.LivreDto>
@{
    ViewData["Title"] = "Gestion des livres";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Gestion des livres</h2>
    @if (User.IsInRole("Administrateur") || User.IsInRole("Bibliothécaire"))
    {
        <a asp-action="Create" class="btn btn-primary">Ajouter un livre</a>
    }
</div>

<div class="row mb-3">
    <div class="col-md-6">
        <input type="text" class="form-control" id="searchInput" placeholder="Rechercher un livre...">
    </div>
    <div class="col-md-3">
        <select class="form-select" id="filterDisponibilite">
            <option value="">Tous les livres</option>
            <option value="true">Disponibles uniquement</option>
            <option value="false">Empruntés uniquement</option>
        </select>
    </div>
</div>

<div class="card">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-striped" id="livresTable">
                <thead>
                    <tr>
                        <th>Titre</th>
                        <th>Auteur</th>
                        <th>Genre</th>
                        <th>Catégorie</th>
                        <th>ISBN</th>
                        <th>Année</th>
                        <th>Disponibilité</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var livre in Model)
                    {
                        <tr data-disponible="@livre.Disponible.ToString().ToLower()">
                            <td>@livre.Titre</td>
                            <td>@livre.Auteur</td>
                            <td>@livre.Genre</td>
                            <td>@livre.Categorie</td>
                            <td>@livre.Isbn</td>
                            <td>@livre.AnneePublication</td>
                            <td>
                                <span class="badge bg-@(livre.Disponible ? "success" : "danger")">
                                    @(livre.Disponible ? "Disponible" : "Emprunté")
                                </span>
                            </td>
                            <td>
                                <div class="btn-group" role="group">
                                    <a asp-action="Details" asp-route-id="@livre.Id" class="btn btn-sm btn-outline-info">Détails</a>
                                    @if (User.IsInRole("Administrateur") || User.IsInRole("Bibliothécaire"))
                                    {
                                        <a asp-action="Edit" asp-route-id="@livre.Id" class="btn btn-sm btn-outline-warning">Modifier</a>
                                    }
                                    @if (User.IsInRole("Administrateur"))
                                    {
                                        <a asp-action="Delete" asp-route-id="@livre.Id" class="btn btn-sm btn-outline-danger">Supprimer</a>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const searchInput = document.getElementById('searchInput');
            const filterSelect = document.getElementById('filterDisponibilite');
            const table = document.getElementById('livresTable');
            const rows = table.querySelectorAll('tbody tr');

            function filterTable() {
                const searchTerm = searchInput.value.toLowerCase();
                const disponibiliteFilter = filterSelect.value;

                rows.forEach(row => {
                    const text = row.textContent.toLowerCase();
                    const disponible = row.getAttribute('data-disponible');

                    const matchesSearch = text.includes(searchTerm);
                    const matchesFilter = disponibiliteFilter === '' || disponible === disponibiliteFilter;

                    row.style.display = matchesSearch && matchesFilter ? '' : 'none';
                });
            }

            searchInput.addEventListener('input', filterTable);
            filterSelect.addEventListener('change', filterTable);
        });
    </script>
}