@model ApiBiblio.Models.Livre
@{
    ViewBag.Title = "Ajouter un livre";
    Layout = "_Layout";
}
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;700&family=Merriweather:wght@700&display=swap" rel="stylesheet">

<style>
    .bibli-form-card {
        background: #F5F6F8;
        border-radius: 1.5rem;
        box-shadow: 0 4px 16px rgba(40,68,117,0.10);
        border: none;
        padding: 2rem 2.5rem 1.5rem 2.5rem;
        max-width: 520px;
        margin: 2rem auto;
    }

    .form-title {
        color: #284475;
        font-family: 'Merriweather', serif;
        text-align: center;
        margin-bottom: 1.5rem;
    }

    .form-label {
        color: #284475;
        font-weight: bold;
    }

    .form-select, .form-control {
        border-radius: 1rem;
    }

    .btn-main {
        background: #72D6C9;
        color: #284475;
        border-radius: 1.5rem;
        font-weight: bold;
        border: none;
        box-shadow: 0 2px 8px rgba(40,68,117,0.09);
        transition: background 0.2s, color 0.2s;
    }

        .btn-main:hover {
            background: #427AA1;
            color: #FFD447;
        }
</style>
