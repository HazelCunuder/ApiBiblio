@model ApiBiblio.Models.Livre
@{
    ViewBag.Title = "Ajouter un livre";
    Layout = "_Layout";
}
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;700&family=Merriweather:wght@700&display=swap" rel="stylesheet">

<style>
    .bibli-form-card {
        background: #F5F6F8;
        border-radius: 1.5rem;
        box-shadow: 0 4px 16px rgba(40,68,117,0.10);
        border: none;
        padding: 2rem 2.5rem 1.5rem 2.5rem;
        max-width: 520px;
        margin: 2rem auto;
    }

    .form-title {
        color: #284475;
        font-family: 'Merriweather', serif;
        text-align: center;
        margin-bottom: 1.5rem;
    }

    .form-label {
        color: #284475;
        font-weight: bold;
    }

    .form-select, .form-control {
        border-radius: 1rem;
    }

    .btn-main {
        background: #72D6C9;
        color: #284475;
        border-radius: 1.5rem;
        font-weight: bold;
        border: none;
        box-shadow: 0 2px 8px rgba(40,68,117,0.09);
        transition: background 0.2s, color 0.2s;
    }

        .btn-main:hover {
            background: #427AA1;
            color: #FFD447;
        }
</style>

<div class="bibli-form-card">
    <h2 class="form-title">Ajouter un Livre</h2>
    <form asp-action="Create" method="post">
        <div class="mb-3">
            <label class="form-label">Titre</label>
            <input asp-for="Titre" class="form-control" />
            <span asp-validation-for="Titre" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label class="form-label">Disponible</label>
            <input asp-for="Disponible" class="form-check-input" type="checkbox" />
        </div>
        <div class="mb-3">
            <label class="form-label">Année de Publication</label>
            <input asp-for="AnnePublication" class="form-control" />
            <span asp-validation-for="AnnePublication" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label class="form-label">ISBN</label>
            <input asp-for="ISBN" class="form-control" />
            <span asp-validation-for="ISBN" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label class="form-label">Catégorie</label>
            <select asp-for="IdCategorie" asp-items="@(ViewData["IdCategorie"] as IEnumerable<SelectListItem>)" class="form-select"></select>
            <span asp-validation-for="IdCategorie" class="text-danger"></span>
        </div>
        <button type="submit" class="btn btn-main mt-3">
            <i class="bi bi-plus-circle"></i> Ajouter
        </button>
        <a asp-action="Index" class="btn btn-secondary mt-3" style="border-radius:1.5rem;">Annuler</a>
    </form>
</div>
@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}
