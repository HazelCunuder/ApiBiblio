@model ApiBiblio.Models.Livre
@{
    ViewBag.Title = "Supprimer le livre";
    Layout = "_Layout";
}
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;700&family=Merriweather:wght@700&display=swap" rel="stylesheet">

<style>
    .bibli-form-card {
        background: #F5F6F8;
        border-radius: 1.5rem;
        box-shadow: 0 4px 16px rgba(40,68,117,0.10);
        border: none;
        padding: 2rem 2.5rem 1.5rem 2.5rem;
        max-width: 520px;
        margin: 2rem auto;
    }

    .form-title {
        color: #EC5B5B;
        font-family: 'Merriweather', serif;
        text-align: center;
        margin-bottom: 1.5rem;
    }

    .form-label {
        color: #284475;
        font-weight: bold;
    }

    .btn-main {
        background: #EC5B5B;
        color: #fff;
        border-radius: 1.5rem;
        font-weight: bold;
        border: none;
        box-shadow: 0 2px 8px rgba(40,68,117,0.09);
        transition: background 0.2s, color 0.2s;
    }

        .btn-main:hover {
            background: #FFD447;
            color: #284475;
        }
</style>

<div class="bibli-form-card">
    <h2 class="form-title">Supprimer le Livre</h2>
    <div class="alert alert-warning mb-3 text-center">
        <strong>Attention :</strong> Voulez-vous vraiment supprimer ce livre ?
    </div>
    <dl class="row mb-4">
        <dt class="col-sm-5">Titre</dt>
        <dd class="col-sm-7">@Model.Titre</dd>
        <dt class="col-sm-5">Catégorie</dt>
        <dd class="col-sm-7">@Model.Categorie?.NomCategorie</dd>
        <dt class="col-sm-5">Année</dt>
        <dd class="col-sm-7">@Model.AnnePublication</dd>
        <dt class="col-sm-5">ISBN</dt>
        <dd class="col-sm-7">@Model.ISBN</dd>
    </dl>
    <form asp-action="Delete" method="post">
        <input type="hidden" asp-for="Id" />
        <button type="submit" class="btn btn-main mt-2">
            <i class="bi bi-trash"></i> Supprimer
        </button>
        <a asp-action="Index" class="btn btn-secondary mt-2" style="border-radius:1.5rem;">Annuler</a>
    </form>
</div>
