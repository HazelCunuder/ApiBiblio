@model ApiBiblio.Models.Genre

@{
    ViewData["Title"] = "Détails du genre";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;700&family=Merriweather:wght@700&display=swap" rel="stylesheet">

<style>
    body {
        background: #FAFAF7;
        color: #273043;
        font-family: 'Inter', sans-serif;
    }

    .genre-details-card {
        background: #fff;
        border-radius: 1.5rem;
        box-shadow: 0 6px 22px rgba(40,68,117,0.12);
        max-width: 500px;
        margin: 2.5rem auto 0 auto;
        padding: 2.2rem 2.2rem 1.2rem 2.2rem;
    }

    .genre-details-title {
        color: #427AA1;
        font-family: 'Merriweather', serif;
        font-size: 2rem;
        font-weight: bold;
        margin-bottom: 2rem;
        text-align: center;
    }

    .genre-details-label {
        color: #427AA1;
        font-weight: 600;
        font-size: 1.1em;
    }

    .btn-edit-main {
        background: #FFD447;
        color: #284475;
        border-radius: 1.4rem;
        font-weight: 600;
        border: none;
        padding: 0.6em 2em;
        font-size: 1.07em;
        transition: background 0.18s, color 0.18s;
        box-shadow: 0 2px 8px rgba(40,68,117,0.09);
        margin-right: 0.7em;
    }

        .btn-edit-main:hover {
            background: #284475;
            color: #FFD447;
        }

    .btn-retour {
        border-radius: 1.2rem;
        color: #427AA1;
        font-weight: 600;
        background: #F5F6F8;
        padding: 0.6em 1.7em;
        border: none;
        transition: background 0.16s, color 0.16s;
    }

        .btn-retour:hover {
            background: #427AA1;
            color: #FFD447;
        }
</style>

<div class="genre-details-card">
    <div class="genre-details-title">
        <i class="bi bi-tags-fill"></i> @ViewData["Title"]
    </div>
    <dl class="row mb-0">
        <dt class="col-sm-4 genre-details-label">
            @Html.DisplayNameFor(model => model.NomGenre)
        </dt>
        <dd class="col-sm-8">
            @Html.DisplayFor(model => model.NomGenre)
        </dd>
    </dl>
    <div class="d-flex justify-content-center mt-4">
        <a asp-action="Edit" asp-route-id="@Model?.Id" class="btn btn-edit-main">
            <i class="bi bi-pencil"></i> Modifier
        </a>
        <a asp-action="Index" class="btn btn-retour">
            <i class="bi bi-arrow-left-circle"></i> Retour
        </a>
    </div>
</div>
