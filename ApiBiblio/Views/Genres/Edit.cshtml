@model ApiBiblio.Models.Genre

@{
    ViewData["Title"] = "Modifier le genre";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container my-4">
    <h1>@ViewData["Title"]</h1>

    <div class="row">
        <div class="col-md-6 col-lg-4">
            <form asp-action="Edit" method="post" novalidate>
                <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
                <input type="hidden" asp-for="Id" />

                <div class="mb-3">
                    <label asp-for="NomGenre" class="form-label"></label>
                    <input asp-for="NomGenre" class="form-control" />
                    <span asp-validation-for="NomGenre" class="text-danger"></span>
                </div>

                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-save"></i> Enregistrer
                </button>
                <a asp-action="Index" class="btn btn-secondary ms-2">Retour à la liste</a>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
