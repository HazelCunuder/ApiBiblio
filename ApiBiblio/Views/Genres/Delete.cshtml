@model ApiBiblio.Models.Genre

@{
    ViewData["Title"] = "Supprimer le genre";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container my-4">
    <h1>@ViewData["Title"]</h1>

    <h3>Voulez-vous vraiment supprimer ce genre ?</h3>

    <div class="card">
        <div class="card-header">
            <strong>Genre</strong>
        </div>
        <div class="card-body">
            <dl class="row">
                <dt class="col-sm-3">@Html.DisplayNameFor(model => model.NomGenre)</dt>
                <dd class="col-sm-9">@Html.DisplayFor(model => model.NomGenre)</dd>
            </dl>

            <form asp-action="Delete" method="post">
                <input type="hidden" asp-for="Id" />
                <button type="submit" class="btn btn-danger me-2">
                    <i class="bi bi-trash"></i> Supprimer
                </button>
                <a asp-action="Index" class="btn btn-secondary">
                    <i class="bi bi-arrow-left"></i> Retour à la liste
                </a>
            </form>
        </div>
    </div>
</div>
