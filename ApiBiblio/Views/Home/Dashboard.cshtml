@{
    ViewData["Title"] = "Dashboard";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var empruntsRecents = ViewBag.EmpruntsRecents as IEnumerable<dynamic>;
}

<div class="row">
    <div class="col-12">
        <h2>Tableau de bord - Bibliothèque Simplon</h2>
    </div>
</div>

<div class="row mt-4">
    <div class="col-md-3">
        <div class="card text-white bg-primary">
            <div class="card-body">
                <h5 class="card-title">Livres totaux</h5>
                <h3>@ViewBag.TotalLivres</h3>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-white bg-success">
            <div class="card-body">
                <h5 class="card-title">Livres disponibles</h5>
                <h3>@ViewBag.LivresDisponibles</h3>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-white bg-warning">
            <div class="card-body">
                <h5 class="card-title">Emprunts en cours</h5>
                <h3>@ViewBag.EmpruntsEnCours</h3>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-white bg-info">
            <div class="card-body">
                <h5 class="card-title">Membres actifs</h5>
                <h3>@ViewBag.MembresActifs</h3>
            </div>
        </div>
    </div>
</div>

<div class="row mt-4">
    <div class="col-md-8">
        <div class="card">
            <div class="card-header">
                <h5>Emprunts récents</h5>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-striped" id="empruntsTable">
                        <thead>
                            <tr>
                                <th>Date</th>
                                <th>Membre</th>
                                <th>Livre</th>
                                <th>Statut</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (empruntsRecents != null && empruntsRecents.Any())
                            {
                                foreach (var e in empruntsRecents)
                                {
                                    <tr>
                                        <td>@((e.Date as DateTime?)?.ToString("dd/MM/yyyy") ?? "-")</td>
                                        <td>@e.Membre</td>
                                        <td>@e.Livre</td>
                                        <td>
                                            <span class="badge bg-@(e.Statut == "En cours" ? "warning" : "success")">
                                                @e.Statut
                                            </span>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="4">Aucun emprunt récent</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card">
            <div class="card-header">
                <h5>Actions rapides</h5>
            </div>
            <div class="card-body">
                <div class="d-grid gap-2">
                    <a href="/Livres/Create" class="btn btn-primary">Ajouter un livre</a>
                    <a href="/Membres/Create" class="btn btn-success">Ajouter un membre</a>
                    <a href="/Emprunts/Create" class="btn btn-warning">Nouvel emprunt</a>
                    <a href="/Emprunts/Index" class="btn btn-info">Gérer les retours</a>
                </div>
            </div>
        </div>
    </div>
</div>
