@using System.Security.Claims

@if (User.Identity.IsAuthenticated)
{
    <p>Connecté : oui</p>
    <p>Prénom (ClaimTypes.Name) : @User.Identity.Name</p>
    <p>Nom d'utilisateur (Login) : @User.FindFirstValue(ClaimTypes.NameIdentifier)</p>
    <p>
        Rôle actuel :
        @if (User.IsInRole("Admin"))
        {
            <b>Admin</b>
        }
        else if (User.IsInRole("Employe"))
        {

            <b>Employé</b>
        }
        else
        {

            <b>aucun</b>
        }
    </p>
    <p>Tous les claims :</p>
    <ul>
        @foreach (var c in User.Claims)
        {
            <li>@c.Type : @c.Value</li>
        }
    </ul>
}
else
{
    <p>Non connecté</p>
}
