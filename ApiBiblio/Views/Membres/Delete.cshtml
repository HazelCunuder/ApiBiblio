@model ApiBiblio.Models.Membre
@{
    ViewBag.Title = "Supprimer un membre";
}
<div class="container mt-4" style="max-width:500px;">
    <h3 style="color:#EC5B5B;font-family:'Merriweather',serif;">Supprimer ce membre ?</h3>
    <div class="alert alert-warning mt-3 mb-4">
        <b>Attention :</b> Cette action est irréversible.
    </div>
    <dl class="row">
        <dt class="col-sm-4">Prénom</dt>
        <dd class="col-sm-8">@Model.PrenomMembre</dd>
        <dt class="col-sm-4">Nom</dt>
        <dd class="col-sm-8">@Model.NomMembre</dd>
        <dt class="col-sm-4">Email</dt>
        <dd class="col-sm-8">@Model.AdresseMail</dd>
    </dl>
    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />
        <button type="submit" class="btn btn-danger" style="border-radius:1em;">
            <i class="bi bi-trash"></i> Supprimer
        </button>
        <a asp-action="Index" class="btn btn-outline-secondary" style="border-radius:1em;">Annuler</a>
    </form>
</div>