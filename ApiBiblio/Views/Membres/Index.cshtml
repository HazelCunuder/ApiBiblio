@model IEnumerable<ApiBiblio.Models.Membre>

@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.NomMembre)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.PrenomMembre)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.MdpMembre)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.AdressePostale)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.AdresseMail)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Telephone)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.NomMembre)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.PrenomMembre)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.MdpMembre)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.AdressePostale)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.AdresseMail)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Telephone)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.Id">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.Id">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.Id">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
